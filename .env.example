# ---- Claude (Anthropic) ----
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# ---- Telegram ----
# מ-@BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# ה-ID של הצ'אט האישי / הערוץ (ראו docs/TELEGRAM_SETUP.md)
TELEGRAM_CHAT_ID=123456789
# HTML (מומלץ) או MarkdownV2
TELEGRAM_PARSE_MODE=HTML

# ---- Facebook (Phase 2 — אופציונלי) ----
# true כדי לפרסם גם לעמוד פייסבוק. ראו docs/FACEBOOK_SETUP.md
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v21.0

# ---- Database ----
DATABASE_PATH=storage/music_agent.db

# ---- General ----
TIMEZONE=Asia/Jerusalem
LOG_LEVEL=INFO
# שעת הפרסום היומית בפורמט HH:MM (מצב scheduler)
POST_TIME=20:00
# כמה שירים לשלוח בכל הרצה
SONGS_PER_DAY=1
# true = לא שולח לטלגרם, רק מדפיס למסך
DRY_RUN=false
